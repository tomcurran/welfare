<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- DataStore contains account credentials and device-specific sync state -->
        <exclude domain="file" path="datastore/welfare_prefs.preferences_pb"/>
        <!-- Database can be fully re-synced from Health Connect -->
        <exclude domain="database" path="weight.db"/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="datastore/welfare_prefs.preferences_pb"/>
        <exclude domain="database" path="weight.db"/>
    </device-transfer>
</data-extraction-rules>
